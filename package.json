{
  "name": "8415wallet",
  "version": "0.1.0",
  "private": true,
  "description": "General-purpose wallet with existing wallet and asset standards compatibility and native ERC-8415 support",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" tests/auth-provisioning.test.mjs tests/auth-qr.test.mjs tests/auth-activation.test.mjs tests/auth-install.test.mjs tests/auth-package.test.mjs tests/dapp-install.test.mjs tests/auth-mail-config.test.mjs tests/auth-legacy-migration.test.mjs tests/tenant-password-routing.test.mjs tests/tenant-password-package-closure.test.mjs tests/license-packaging.test.mjs tests/product-source.test.mjs tests/task-receipt-observation.test.mjs tests/task-receipt-package-closure.test.mjs",
    "verify": "npm run typecheck && npm test && npm run test:evm",
    "wallet": "node src/cli/main.ts",
    "wallet:browser:build": "tsc -p tsconfig.browser.json && node scripts/package/build-login-vendor.mjs",
    "wallet:browser:serve": "node scripts/controls/serve-browser.cjs",
    "wallet:controls:testnet": "node scripts/controls/public-testnet.cjs",
    "wallet:controls:signer": "node scripts/controls/testnet-signer.cjs",
    "wallet:ui:journey": "node scripts/controls/browser-journey.cjs",
    "test:evm": "hardhat test",
    "pack:v2": "node scripts/package/build-v2.mjs",
    "pack:v2:verify": "node scripts/package/verify-install.mjs",
    "pack:v3": "node scripts/package/build-v3.mjs",
    "pack:v3:verify": "node scripts/package/verify-install-v3.mjs",
    "wallet:xiongan:smoke": "node scripts/controls/xiongan-ui-smoke.cjs",
    "pack:dapp": "node scripts/package/build-dapp.mjs",
    "pack:dapp:v2": "node scripts/package/build-dapp.mjs --profile v2",
    "pack:dapp:v3": "node scripts/package/build-dapp.mjs --profile v3",
    "pack:dapp:all": "npm run pack:dapp:v2 && npm run pack:dapp:v3",
    "pack:dapp:verify": "node scripts/package/verify-dapp.mjs",
    "test:package:dapp": "node --test tests/dapp-release.test.mjs",
    "wallet:auth:serve": "node server/main.mjs",
    "wallet:auth:operator": "node server/operator-init.mjs",
    "test:auth": "node --test tests/auth-password.test.ts tests/auth-service.test.ts tests/auth-recovery.test.ts tests/auth-registration.test.ts tests/auth-crypto.test.ts tests/ca-verifier.test.ts tests/account-login.test.ts tests/account-login-ui.test.ts tests/auth-provisioning.test.mjs tests/auth-qr.test.mjs tests/auth-activation.test.mjs tests/auth-install.test.mjs tests/auth-mail-config.test.mjs tests/auth-legacy-migration.test.mjs",
    "wallet:auth:activate": "node server/operator-activate.mjs",
    "wallet:auth:install": "node deploy/auth-xiongan/install.mjs",
    "pack:auth": "node scripts/package/build-auth.mjs",
    "pack:auth:verify": "node scripts/package/verify-auth.mjs",
    "test:package:auth": "node --test tests/auth-package.test.mjs",
    "test:auth:installed": "node --test tests/auth-installed.test.mjs tests/auth-legacy-installed.test.mjs",
    "pack:delivery": "node scripts/package/build-delivery.mjs",
    "pack:delivery:verify": "node scripts/package/verify-delivery.mjs --manifest dist/delivery-package-manifest.json",
    "wallet:dapp:install": "node deploy/dapp/install.mjs",
    "test:package:delivery": "node --test tests/dapp-install.test.mjs",
    "wallet:auth:migrate-legacy": "node deploy/auth-xiongan/migrate-legacy.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/node": "^22.0.0",
    "hardhat": "^2.29.0",
    "playwright-core": "^1.56.1",
    "solc": "^0.8.37",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "tmp": "0.2.7",
    "serialize-javascript": "7.1.2",
    "undici": "6.29.0",
    "diff": "8.0.3",
    "cookie": "0.7.2",
    "uuid": "11.1.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./controls": "./src/controls/index.ts",
    "./controls/node-store": "./src/controls/fileOperationStore.ts",
    "./browser": "./src/browser.ts",
    "./v2": "./src/v2.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
